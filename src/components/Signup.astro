---
/*
  NEWSLETTER PLACEHOLDER
  Swap this component for a Beehiiv or Substack embed later.
  Look for data-newsletter-provider="placeholder".
  Do not point this form at a live list until an account exists.
*/
---

<section
  class="section"
  id="signup"
  aria-labelledby="signup-heading"
  data-newsletter-provider="placeholder"
>
  <div class="wrap">
    <div class="signup">
      <p class="kicker">Newsletter · Mondays</p>
      <h2 id="signup-heading">Get the lab notes when the list is live.</h2>
      <p class="lead" style="margin-top: 0.85rem;">
        One email a week. Three tools, a keep or drop, and the disclosure notes your store page will need.
        Issues also stay on the web with no signup wall.
      </p>
      <p class="notice" id="signup-note" role="note">
        <strong>Signup is not connected yet.</strong>
        This form is a clearly marked placeholder so a Beehiiv or Substack embed can replace it later.
        It does not collect, store, or send your email.
      </p>
      <form class="signup-form" id="newsletter-form" method="post" aria-describedby="signup-note">
        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@studio.example"
          inputmode="email"
          disabled
        />
        <button class="btn btn-primary" type="submit" disabled>Notify me later</button>
        <p class="form-status" id="signup-status" role="status">
          The list is not open. No email is being collected.
        </p>
      </form>
    </div>
  </div>
</section>
<script>
  const form = document.getElementById("newsletter-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const status = document.getElementById("signup-status");
    if (status) {
      status.textContent =
        "Signup is still a placeholder. Your email was not sent or stored.";
    }
  });
</script>
