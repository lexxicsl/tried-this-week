---
import { SITE, withBase } from "../lib/site";

/*
  Beehiiv subscribe embed.
  Attribution script lives once in src/layouts/Base.astro — do not add it here.
*/
---

<section
  class="section"
  id="signup"
  aria-labelledby="signup-heading"
  data-newsletter-provider="beehiiv"
>
  <div class="wrap">
    <div class="signup">
      <p class="kicker">Newsletter · Mondays</p>
      <h2 id="signup-heading">Get the lab notes every Monday.</h2>
      <p class="lead" style="margin-top: 0.85rem;">
        <strong>What you get.</strong> One email a week: three tools, a keep or drop, and the
        disclosure notes your store page will need. Issues also stay on the web with no signup wall.
      </p>
      <div class="signup-embed">
        <script
          is:inline
          async
          src="https://subscribe-forms.beehiiv.com/v3/loader.js"
          data-beehiiv-form="0d0e1cdb-039a-4038-8e57-3fc70282fad9"></script>
        <noscript>
          <p>
            JavaScript is required for this form. You can subscribe or
            <a href={SITE.beehiiv}>read past issues on Beehiiv</a>.
            Every issue also stays on the web, with no signup wall, in the
            <a href={withBase("/issues/")}>issues archive</a>.
          </p>
        </noscript>
      </div>
      <p class="signup-aside">
        <a href={SITE.beehiiv}>Read past issues on Beehiiv</a>
      </p>
    </div>
  </div>
</section>
