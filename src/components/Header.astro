---
import { NAV, SITE, withBase } from "../lib/site";

const current = Astro.url.pathname;
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={withBase("/")}>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="1" y="1" width="30" height="30" fill="none" stroke="#d6ff3f" stroke-width="2"></rect>
        <path d="M8 20 V10 H16 M8 15 H14 M20 10 V20 H26" fill="none" stroke="#d6ff3f" stroke-width="2.2" stroke-linecap="square"></path>
      </svg>
      <span class="brand-name">{SITE.name}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" id="menu-toggle">
      Menu
    </button>
    <nav class="nav" id="site-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={withBase(item.href)}
          aria-current={current === withBase(item.href) || current.startsWith(withBase(item.href)) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="btn btn-primary" href={`${withBase("/")}#signup`}>Get the issue</a>
    </nav>
  </div>
</header>
<script>
  const button = document.getElementById("menu-toggle");
  const nav = document.getElementById("site-nav");
  button?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") ?? false;
    button.setAttribute("aria-expanded", String(open));
    button.textContent = open ? "Close" : "Menu";
  });
</script>
