---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/site";
---

<Base title="Page not found" description="That page is not in the Tried This Week lab." path="/404/" noindex={true}>
  <section class="not-found">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1 class="display">This page is not on the bench.</h1>
      <p class="lead">The URL does not match a published page. It may have been typed wrong, or it is not out yet.</p>
      <div class="actions">
        <a class="btn btn-primary" href={withBase("/")}>Back to the lab</a>
        <a class="btn btn-ghost" href={withBase("/issues/")}>Browse issues</a>
      </div>
    </div>
  </section>
</Base>
